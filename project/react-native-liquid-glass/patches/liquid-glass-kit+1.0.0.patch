+package dev.liquidglass.view
+
+import android.view.View
+
+/** Tracks layout and animated transform changes without allocating per draw. */
+internal class ViewGeometryVersion(private val view: View) {
+
+    private var initialized = false
+    private var fingerprint = 0L
+    private var version = 0L
+
+    fun current(): Long {
+        var next = -0x340d631b7bdddcdbL
+        var current: View? = view
+        while (current != null) {
+            next = mix(next, System.identityHashCode(current).toLong())
+            next = mix(next, current.left.toLong())
+            next = mix(next, current.top.toLong())
+            next = mix(next, current.width.toLong())
+            next = mix(next, current.height.toLong())
+            next = mix(next, current.scrollX.toLong())
+            next = mix(next, current.scrollY.toLong())
+            next = mix(next, bits(current.translationX))
+            next = mix(next, bits(current.translationY))
+            next = mix(next, bits(current.scaleX))
+            next = mix(next, bits(current.scaleY))
+            next = mix(next, bits(current.rotation))
+            next = mix(next, bits(current.rotationX))
+            next = mix(next, bits(current.rotationY))
+            next = mix(next, bits(current.pivotX))
+            next = mix(next, bits(current.pivotY))
+            current = current.parent as? View
+        }
+        if (!initialized || fingerprint != next) {
+            initialized = true
+            fingerprint = next
+            version += 1L
+        }
+        return version
+    }
+
+    private fun mix(seed: Long, value: Long): Long = (seed xor value) * 0x100000001b3L
+    private fun bits(value: Float): Long = java.lang.Float.floatToIntBits(value).toLong()
+}
+
+/** Geometry and optical sampling extent for a registered glass view. */
+public interface LiquidGlassSamplingConsumer {
+    public val geometryVersion: Long
+    public val opticalSamplingMarginPx: Int
+}
