+package expo.modules.liquidglass
+
+import android.graphics.Rect
+import android.view.View
+import android.view.ViewGroup
+import dev.liquidglass.view.BackdropRecorder
+import dev.liquidglass.view.ViewGeometryVersion
+import dev.liquidglass.view.ViewGeometryMapper
+import java.util.IdentityHashMap
+import kotlin.math.ceil
+import kotlin.math.max
+
+/** Rejects source invalidations that cannot affect any registered glass sample. */
+internal class DirtyRegionTracker(
+    private val source: LiquidGlassProviderExpoView,
+    private val recorder: BackdropRecorder,
+) {
+
+    private val dirtyRect = Rect()
+    private val clipRect = Rect()
+    private val geometryMapper = ViewGeometryMapper()
+    private val targetGeometry = IdentityHashMap<View, TargetGeometry>()
+
+    private class TargetGeometry(view: View) {
+        val versionTracker = ViewGeometryVersion(view)
+        val bounds = Rect()
+        var version = Long.MIN_VALUE
+        var width = -1
+        var height = -1
+        var scaleX = Float.NaN
+        var scaleY = Float.NaN
+        var elevation = Float.NaN
+    }
+
+    val region: Rect
+        get() = dirtyRect
+
+    fun intersectsConsumerSampling(target: View): Boolean {
+        dirtyRect.setEmpty()
+        if (!recorder.hasConsumers || !source.isAttachedToWindow || !target.isAttachedToWindow) return false
+
+        if (target === source) {
+            dirtyRect.set(0, 0, source.width, source.height)
+        } else {
+            val targetCache = geometryFor(target)
+            val version = targetCache.versionTracker.current()
+            if (targetCache.version != version || targetCache.width != target.width ||
+                targetCache.height != target.height || targetCache.scaleX != target.scaleX ||
+                targetCache.scaleY != target.scaleY || targetCache.elevation != target.elevation
+            ) {
+                if (!geometryMapper.mapBounds(target, source, targetCache.bounds)) return false
+                targetCache.version = version
+                targetCache.width = target.width
+                targetCache.height = target.height
+                targetCache.scaleX = target.scaleX
+                targetCache.scaleY = target.scaleY
+                targetCache.elevation = target.elevation
+            }
+            dirtyRect.set(targetCache.bounds)
+        }
+
+        val density = source.resources.displayMetrics.density
+        val safetyMargin = ceil(max(2f, target.elevation * 1.5f + 2f * density)).toInt()
+        dirtyRect.inset(-safetyMargin, -safetyMargin)
+        if (!clipToAncestors(target)) {
+            dirtyRect.setEmpty()
+            return false
+        }
+        if (!dirtyRect.intersect(0, 0, source.width, source.height)) dirtyRect.setEmpty()
+        return !dirtyRect.isEmpty && recorder.intersectsConsumerSampling(source, dirtyRect)
+    }
+
+    private fun clipToAncestors(target: View): Boolean {
+        var ancestor = target.parent as? View
+        while (ancestor != null && ancestor !== source) {
+            if (ancestor is ViewGroup && (ancestor.clipChildren || ancestor.clipToPadding)) {
+                val mapped = if (ancestor.clipToPadding) {
+                    geometryMapper.mapLocalBounds(
+                        ancestor,
+                        source,
+                        ancestor.paddingLeft.toFloat(),
+                        ancestor.paddingTop.toFloat(),
+                        (ancestor.width - ancestor.paddingRight).toFloat(),
+                        (ancestor.height - ancestor.paddingBottom).toFloat(),
+                        clipRect,
+                    )
+                } else {
+                    geometryMapper.mapBounds(ancestor, source, clipRect)
+                }
+                if (!mapped || !Rect.intersects(dirtyRect, clipRect)) return false
+                dirtyRect.intersect(clipRect)
+            }
+            ancestor = ancestor.parent as? View
+        }
+        return !dirtyRect.isEmpty
+    }
+
+    private fun geometryFor(target: View): TargetGeometry {
+        targetGeometry[target]?.let { return it }
+        if (targetGeometry.size >= MAX_CACHED_TARGETS) {
+            val iterator = targetGeometry.keys.iterator()
+            if (iterator.hasNext()) {
+                targetGeometry.remove(iterator.next())
+            }
+        }
+        return TargetGeometry(target).also { targetGeometry[target] = it }
+    }
+
+    private companion object {
+        const val MAX_CACHED_TARGETS = 256
+    }
+}
