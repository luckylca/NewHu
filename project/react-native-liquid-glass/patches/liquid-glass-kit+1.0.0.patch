+package dev.liquidglass.view
+
+import android.graphics.Matrix
+import android.graphics.Rect
+import android.graphics.RectF
+import android.view.View
+import kotlin.math.ceil
+import kotlin.math.floor
+
+/** Reusable window-space mapping helpers; all scratch storage is retained per owner. */
+internal class ViewGeometryMapper {
+
+    private val sourceToGlobal = Matrix()
+    private val globalToSource = Matrix()
+    private val targetToGlobal = Matrix()
+    private val bounds = RectF()
+
+    fun mapOrigin(target: View, source: View, output: FloatArray): Boolean {
+        if (!prepareSource(source)) return false
+        targetToGlobal.reset()
+        target.transformMatrixToGlobal(targetToGlobal)
+        output[0] = 0f
+        output[1] = 0f
+        targetToGlobal.mapPoints(output)
+        globalToSource.mapPoints(output)
+        return true
+    }
+
+    fun mapBounds(target: View, source: View, output: Rect): Boolean {
+        return mapLocalBounds(target, source, 0f, 0f, target.width.toFloat(), target.height.toFloat(), output)
+    }
+
+    fun mapLocalBounds(
+        target: View,
+        source: View,
+        left: Float,
+        top: Float,
+        right: Float,
+        bottom: Float,
+        output: Rect,
+    ): Boolean {
+        if (right <= left || bottom <= top || !prepareSource(source)) {
+            output.setEmpty()
+            return false
+        }
+        targetToGlobal.reset()
+        target.transformMatrixToGlobal(targetToGlobal)
+        bounds.set(left, top, right, bottom)
+        targetToGlobal.mapRect(bounds)
+        globalToSource.mapRect(bounds)
+        output.set(
+            floor(bounds.left).toInt(),
+            floor(bounds.top).toInt(),
+            ceil(bounds.right).toInt(),
+            ceil(bounds.bottom).toInt(),
+        )
+        return !output.isEmpty
+    }
+
+    private fun prepareSource(source: View): Boolean {
+        sourceToGlobal.reset()
+        source.transformMatrixToGlobal(sourceToGlobal)
+        return sourceToGlobal.invert(globalToSource)
+    }
+}
