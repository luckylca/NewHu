+package expo.modules.liquidglass
+
+import android.graphics.Rect
+import android.view.Choreographer
+import kotlin.math.min
+
+/** Coalesces source dirties and schedules at most one capture per display frame. */
+internal class CaptureScheduler(private val provider: LiquidGlassProviderExpoView) {
+
+    private val dirtyRegions = Rect()
+    private var hasDirtyRegion = false
+    private var scheduled = false
+    private var nextCaptureFrameTimeNanos = Long.MIN_VALUE
+    private var frameTimeNanos = Long.MIN_VALUE
+    private var frameCallbackPosted = false
+
+    val hasPendingCapture: Boolean
+        get() = hasDirtyRegion
+
+    private val frameCallback = Choreographer.FrameCallback { frameTime ->
+        frameTimeNanos = frameTime
+        frameCallbackPosted = false
+        if (hasDirtyRegion) provider.postInvalidateOnAnimation()
+    }
+
+    fun request(region: Rect? = null, schedule: Boolean = true) {
+        LiquidGlassPerfTelemetry.backdropRequest()
+        if (hasDirtyRegion) {
+            LiquidGlassPerfTelemetry.captureSkippedAlreadyDirty()
+        }
+        if (region == null) {
+            dirtyRegions.set(0, 0, provider.width, provider.height)
+            hasDirtyRegion = true
+        } else if (!hasDirtyRegion) {
+            dirtyRegions.set(region)
+            hasDirtyRegion = true
+        } else {
+            dirtyRegions.union(region)
+        }
+        requestFrameTime()
+        if (schedule) scheduleNextFrame()
+    }
+
+    fun shouldCaptureThisFrame(): Boolean {
+        if (!hasDirtyRegion) {
+            scheduled = false
+            return false
+        }
+        val displayRate = (provider.display?.refreshRate ?: 60f).coerceIn(1f, 120f)
+        val captureRate = min(displayRate, provider.maxCaptureRateHz)
+        val minimumIntervalNanos = (1_000_000_000.0 / captureRate).toLong()
+        if (frameTimeNanos == Long.MIN_VALUE) {
+            requestFrameTime()
+            scheduleNextFrame()
+            return false
+        }
+        if (nextCaptureFrameTimeNanos != Long.MIN_VALUE &&
+            frameTimeNanos < nextCaptureFrameTimeNanos
+        ) {
+            requestFrameTime()
+            scheduleNextFrame()
+            return false
+        }
+        hasDirtyRegion = false
+        dirtyRegions.setEmpty()
+        scheduled = false
+        nextCaptureFrameTimeNanos = if (nextCaptureFrameTimeNanos == Long.MIN_VALUE) {
+            frameTimeNanos + minimumIntervalNanos
+        } else {
+            nextCaptureFrameTimeNanos + minimumIntervalNanos
+        }
+        return true
+    }
+
+    fun clear() {
+        if (frameCallbackPosted) Choreographer.getInstance().removeFrameCallback(frameCallback)
+        dirtyRegions.setEmpty()
+        hasDirtyRegion = false
+        scheduled = false
+        nextCaptureFrameTimeNanos = Long.MIN_VALUE
+        frameTimeNanos = Long.MIN_VALUE
+        frameCallbackPosted = false
+    }
+
+    private fun requestFrameTime() {
+        if (frameCallbackPosted) return
+        frameCallbackPosted = true
+        Choreographer.getInstance().postFrameCallback(frameCallback)
+    }
+
+    private fun scheduleNextFrame() {
+        if (scheduled) return
+        scheduled = true
+        LiquidGlassPerfTelemetry.captureScheduled()
+        provider.postInvalidateOnAnimation()
+    }
+}
